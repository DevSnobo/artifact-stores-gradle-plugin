{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>DevSnobo/renovate-config"
  ],
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "constraints": {
    "java": "21"
  },
  "packageRules": [
    {
      "matchManagers": [
        "gradle"
      ],
      "postUpgradeTasks": {
        "commands": [
          "./gradlew resolveAndLockAll --write-locks --write-verification-metadata sha256"
        ],
        "fileFilters": [
          "gradle.lockfile",
          "**/gradle.lockfile",
          "gradle/verification-metadata.xml",
          "**/gradle/verification-metadata.xml"
        ],
        "executionMode": "branch",
        "installTools": {
          "java": {}
        }
      }
    },
    {
      "matchManagers": [
        "gradle"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
